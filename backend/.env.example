# env ของ api (csmju-maintenance-request · ระบบแจ้งซ่อม) — DevOps ใช้ไฟล์นี้เป็นรายการ env บน server
# (standards docs/deployment.md ข้อ 4.2) · ค่าลับส่งให้ DevOps ทางข้อความส่วนตัว ห้าม commit

NODE_ENV=production
PORT=4000
TZ=Asia/Bangkok

# ฐานข้อมูลของระบบนี้เท่านั้น (DevOps กำหนดบน server) · จำกัด connection ต่อระบบ
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/csmju_maintenance_request
DATABASE_POOL_MAX=5

# Core Hub (ค่าตายตัวของสัญญา)
CORE_HUB_URL=https://csmju2030.jowave.com
CORE_HUB_JWKS_URL=https://csmju2030.jowave.com/api/v1/.well-known/jwks.json
CORE_HUB_WEB_URL=https://csmju2030.jowave.com
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030
SUBSYSTEM_ID=csmju-maintenance-request
SUBSYSTEM_NAME=ระบบแจ้งซ่อม

# อีเมลบัญชี Core Hub (core role staff/lecturer) ที่เป็นผู้ดูแลระบบแจ้งซ่อม คั่นด้วย , — ทางชั่วคราว (REPORT ข้อ 8)
ADMIN_ACCOUNTS=
